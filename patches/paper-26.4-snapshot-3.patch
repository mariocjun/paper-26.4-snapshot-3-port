@@ -0,0 +1,42 @@
+package io.papermc.paper.network;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.protocol.common.custom.BrandPayload;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.network.protocol.common.custom.ModListPayload;
+
+/**
+ * Reconstructs the body of vanilla typed payloads for the plugin messenger.
+ */
+public final class TypedCustomPayloadBridge {
+
+    private static final int MAX_PAYLOAD_SIZE = 32767;
+
+    private TypedCustomPayloadBridge() {
+    }
+
+    public static byte[] encode(final CustomPacketPayload payload) {
+        ByteBuf buffer = Unpooled.buffer(256, MAX_PAYLOAD_SIZE);
+        try {
+            if (payload instanceof BrandPayload brand) {
+                FriendlyByteBuf friendlyBuffer = new FriendlyByteBuf(buffer);
+                BrandPayload.STREAM_CODEC.encode(friendlyBuffer, brand);
+                // Retain Paper's original UTF-8 byte and character limits.
+                friendlyBuffer.readUtf(256);
+                buffer.readerIndex(0);
+            } else if (payload instanceof ModListPayload mods) {
+                ModListPayload.STREAM_CODEC.encode(buffer, mods);
+            } else {
+                throw new IllegalArgumentException("Unsupported typed custom payload: " + payload.type().id());
+            }
+
+            byte[] data = new byte[buffer.readableBytes()];
+            buffer.readBytes(data);
+            return data;
+        } finally {
+            buffer.release();
+        }
+    }
+}
