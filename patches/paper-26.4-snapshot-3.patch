+#!/usr/bin/env python3
+"""Prepare the pinned Mache archive by changing six verified hunk coordinates only."""
+import argparse
+import hashlib
+from pathlib import Path
+import zipfile
+
+ORIGINAL_SHA256 = "e74865ffe64350fdeeccbb176df8e652b84762c075b81ca1e324253fc2b3d21b"
+COORDINATES = {
+    "patches/net/minecraft/core/registries/BuiltInRegistries.java.patch": [(396, 397)],
+    "patches/net/minecraft/resources/RegistryDataLoader.java.patch": [(94, 95)],
+    "patches/net/minecraft/util/Util.java.patch": [(630, 621)],
+    "patches/net/minecraft/util/datafix/DataFixers.java.patch": [(1191, 1192), (1227, 1228)],
+    "patches/net/minecraft/world/entity/animal/sniffer/Sniffer.java.patch": [(444, 448)],
+}
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("original", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    digest = hashlib.sha256(args.original.read_bytes()).hexdigest()
+    if digest != ORIGINAL_SHA256:
+        raise SystemExit(f"Unexpected Mache input SHA-256: {digest}")
+    if args.original.resolve() == args.output.resolve():
+        raise SystemExit("Output must differ from the original")
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    changed = 0
+    with zipfile.ZipFile(args.original) as source, zipfile.ZipFile(args.output, "w") as output:
+        for info in source.infolist():
+            contents = source.read(info.filename)
+            for before, after in COORDINATES.get(info.filename, []):
+                old = f"@@ -{before},7 +_,7 @@".encode()
+                new = f"@@ -{after},7 +_,7 @@".encode()
+                if contents.count(old) != 1:
+                    raise SystemExit(f"Expected exactly one header {old!r} in {info.filename}")
+                contents = contents.replace(old, new)
+                changed += 1
+            output.writestr(info, contents)
+    if changed != 6:
+        raise SystemExit(f"Expected six coordinate changes, got {changed}")
+    print(f"Prepared {args.output}; six hunk coordinates, no hunk body changes")
+    print(f"SHA-256 {hashlib.sha256(args.output.read_bytes()).hexdigest()}")
+
+if __name__ == "__main__":
+    main()
