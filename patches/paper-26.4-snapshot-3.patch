+#!/usr/bin/env python3
+"""Read NBT data versions and palette metadata without modifying a disposable world."""
+import argparse, collections, gzip, hashlib, io, json, struct, zlib
+from pathlib import Path
+
+def read_nbt(data):
+    stream=io.BytesIO(data)
+    def number(fmt): return struct.unpack('>'+fmt, stream.read(struct.calcsize(fmt)))[0]
+    def string(): return stream.read(number('H')).decode('utf-8',errors='replace')
+    def payload(kind):
+        if kind in (1,2,3,4,5,6):return number({1:'b',2:'h',3:'i',4:'q',5:'f',6:'d'}[kind])
+        if kind==7:return list(stream.read(number('i')))
+        if kind==8:return string()
+        if kind==9:
+            element=number('B');length=number('i');return [payload(element) for _ in range(length)]
+        if kind==10:
+            result={}
+            while True:
+                element=number('B')
+                if not element: return result
+                key=string();result[key]=payload(element)
+        if kind in (11,12):return [number('i' if kind==11 else 'q') for _ in range(number('i'))]
+        raise ValueError(f'Unknown NBT type {kind}')
+    kind=number('B');string();return payload(kind)
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('world',type=Path);args=parser.parse_args()
+    levelpath=args.world/'level.dat';level=read_nbt(gzip.decompress(levelpath.read_bytes()));versions=collections.Counter();statuses=collections.Counter();samples=[];hashes={};chunk_count=0;origin_chunks=[]
+    for path in sorted(args.world.rglob('*.mca')):
+        if path.parent.name!='region':continue
+        data=path.read_bytes();hashes[str(path.relative_to(args.world))]=hashlib.sha256(data).hexdigest()
+        for slot in range(1024):
+            location=int.from_bytes(data[slot*4:slot*4+4],'big');offset=location>>8
+            if not offset:continue
+            at=offset*4096;length=int.from_bytes(data[at:at+4],'big');compression=data[at+4]
+            if compression&128:continue
+            compressed=data[at+5:at+4+length]
+            nbt=read_nbt(gzip.decompress(compressed) if compression==1 else zlib.decompress(compressed) if compression==2 else compressed)
+            chunk_count+=1;versions[str(nbt.get('DataVersion'))]+=1;statuses[str(nbt.get('status',nbt.get('Status')))]+=1
+            if nbt.get('xPos')==0 and nbt.get('zPos')==0:
+                origin_chunks.append({'region':str(path.relative_to(args.world)),'version':nbt.get('DataVersion'),'status':nbt.get('status',nbt.get('Status')),'bukkit_values':nbt.get('ChunkBukkitValues',nbt.get('BukkitValues')),'section_y6_palette':[state if isinstance(state,str) else state.get('Name') for section in nbt.get('sections',[]) if section.get('Y')==6 for state in section.get('block_states',{}).get('palette',[])]})
+            if len(samples)<6:
+                sections=nbt.get('sections',[]);samples.append({'x':nbt.get('xPos'),'z':nbt.get('zPos'),'version':nbt.get('DataVersion'),'keys':sorted(nbt),'sections':[{'y':s.get('Y'),'biome_palette':s.get('biomes',{}).get('palette'),'biome_data_longs':len(s.get('biomes',{}).get('data',[])),'noise_biomes':'noise_biomes' in s} for s in sections]})
+    print(json.dumps({'world':str(args.world.resolve()),'level_version':level.get('Data',level).get('DataVersion'),'level_sha256':hashlib.sha256(levelpath.read_bytes()).hexdigest(),'chunks':chunk_count,'chunk_versions':versions,'statuses':statuses,'region_hashes':hashes,'origin_chunks':origin_chunks,'samples':samples},indent=2))
+
+if __name__=='__main__':main()
