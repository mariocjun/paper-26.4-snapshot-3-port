+package org.bukkit.craftbukkit.generator;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkTaskScheduler;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.Test;
+
+@VanillaFeature
+class ChunkStatusSchedulingTest {
+    @Test
+    void everyVanillaStageHasAFiniteWriteRadius() throws ClassNotFoundException {
+        Class.forName(ChunkTaskScheduler.class.getName());
+        for (ChunkStatus status : ChunkStatus.getStatusList()) {
+            assertTrue(status.moonrise$getWriteRadius() >= 0, () -> "Missing Moonrise write radius: " + status);
+        }
+        assertEquals(0, ChunkStatus.NOISE_BIOMES.moonrise$getWriteRadius());
+        assertTrue(ChunkStatus.NOISE_BIOMES.moonrise$isParallelCapable());
+        assertTrue(ChunkStatus.NOISE_BIOMES.moonrise$isEmptyLoadStatus());
+        assertFalse(ChunkStatus.FEATURES.moonrise$isEmptyLoadStatus(), "Load must drop temporary noise biomes");
+    }
+}
