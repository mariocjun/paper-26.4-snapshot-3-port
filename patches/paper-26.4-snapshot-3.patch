+package org.bukkit.craftbukkit.generator;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import java.util.HashMap;
+import java.util.Map;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Holder;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.biome.BiomeSource;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import org.bukkit.block.Biome;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.craftbukkit.block.CraftBiome;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.Test;
+
+@VanillaFeature
+class CustomBiomeGridPrecisionTest {
+    @Test
+    void gridPreservesAdjacentBlockBiomesAndWritesEveryHeight() {
+        ServerLevel world = mock(ServerLevel.class);
+        CraftWorld craftWorld = mock(CraftWorld.class);
+        when(world.getWorld()).thenReturn(craftWorld);
+        when(craftWorld.getMinHeight()).thenReturn(-16);
+        when(craftWorld.getMaxHeight()).thenReturn(16);
+        net.minecraft.world.level.chunk.ChunkGenerator delegate = mock(net.minecraft.world.level.chunk.ChunkGenerator.class);
+        when(delegate.getBiomeSource()).thenReturn(mock(BiomeSource.class));
+        CustomChunkGenerator generator = new CustomChunkGenerator(world, delegate, mock(org.bukkit.generator.ChunkGenerator.class));
+        ChunkAccess chunk = mock(ChunkAccess.class);
+        when(chunk.getPos()).thenReturn(new ChunkPos(-2, 3));
+        Map<BlockPos, Holder<net.minecraft.world.level.biome.Biome>> biomes = new HashMap<>();
+        doAnswer(invocation -> {
+            biomes.put(new BlockPos((int) invocation.getArgument(0), (int) invocation.getArgument(1), (int) invocation.getArgument(2)), invocation.getArgument(3));
+            return null;
+        }).when(chunk).setBiome(anyInt(), anyInt(), anyInt(), any());
+        when(chunk.getBiome(anyInt(), anyInt(), anyInt())).thenAnswer(invocation -> biomes.get(new BlockPos((int) invocation.getArgument(0), (int) invocation.getArgument(1), (int) invocation.getArgument(2))));
+        CustomChunkGenerator.CustomBiomeGrid grid = generator.new CustomBiomeGrid(chunk);
+        grid.setBiome(0, 1, 0, Biome.PLAINS);
+        grid.setBiome(1, 1, 0, Biome.DESERT);
+        assertEquals(Biome.PLAINS, grid.getBiome(0, 1, 0));
+        assertEquals(Biome.DESERT, grid.getBiome(1, 1, 0));
+        grid.setBiome(2, 3, Biome.FOREST);
+        for (int y = -16; y < 16; y++) {
+            assertEquals(CraftBiome.bukkitToMinecraftHolder(Biome.FOREST), biomes.get(new BlockPos(-30, y, 51)));
+        }
+    }
+
+    @Test
+    void legacySectionReplacementCopiesAll4096BiomeCells() {
+        LevelChunkSection source = mock(LevelChunkSection.class);
+        LevelChunkSection target = mock(LevelChunkSection.class);
+        Holder<net.minecraft.world.level.biome.Biome> plains = CraftBiome.bukkitToMinecraftHolder(Biome.PLAINS);
+        Holder<net.minecraft.world.level.biome.Biome> desert = CraftBiome.bukkitToMinecraftHolder(Biome.DESERT);
+        when(source.getBiome(anyInt(), anyInt(), anyInt())).thenAnswer(invocation -> (int) invocation.getArgument(0) == 1 ? desert : plains);
+        Map<BlockPos, Holder<net.minecraft.world.level.biome.Biome>> copied = new HashMap<>();
+        doAnswer(invocation -> {
+            copied.put(new BlockPos((int) invocation.getArgument(0), (int) invocation.getArgument(1), (int) invocation.getArgument(2)), invocation.getArgument(3));
+            return null;
+        }).when(target).setBiome(anyInt(), anyInt(), anyInt(), any());
+        CustomChunkGenerator.copyBiomes(source, target);
+        assertEquals(4096, copied.size());
+        assertEquals(plains, copied.get(new BlockPos(0, 15, 15)));
+        assertEquals(desert, copied.get(new BlockPos(1, 15, 15)));
+        assertEquals(plains, copied.get(new BlockPos(15, 15, 15)));
+    }
+}
diff --git a/paper-server/src/test/java/org/bukkit/craftbukkit/generator/TerrainStagesTest.java b/paper-server/src/test/java/org/bukkit/craftbukkit/generator/TerrainStagesTest.java
