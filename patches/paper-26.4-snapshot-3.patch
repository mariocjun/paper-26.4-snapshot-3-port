+#!/usr/bin/env python3
+"""Run an explicitly supplied local JAR in a disposable loopback-only directory."""
+import argparse, hashlib, json, queue, socket, struct, subprocess, threading, time
+from pathlib import Path
+
+def status_probe(port):
+    def varint(value):
+        value &= 0xffffffff
+        out=bytearray()
+        while True:
+            byte=value&127;value>>=7;out.append(byte|(128 if value else 0))
+            if not value:return bytes(out)
+    with socket.create_connection(('127.0.0.1',port),timeout=5) as connection:
+        def read_exact(length):
+            data=b''
+            while len(data)<length:
+                part=connection.recv(length-len(data))
+                if not part:raise EOFError('Status connection closed')
+                data+=part
+            return data
+        def read_varint():
+            value=0
+            for shift in range(0,35,7):
+                byte=read_exact(1)[0];value|=(byte&127)<<shift
+                if not byte&128:return value
+            raise ValueError('Invalid status VarInt')
+        address=b'localhost';handshake=b'\0'+varint(-1)+varint(len(address))+address+struct.pack('>H',port)+b'\1'
+        connection.sendall(varint(len(handshake))+handshake+b'\1\0')
+        read_varint()
+        if read_varint()!=0:raise ValueError('Unexpected status packet')
+        return json.loads(read_exact(read_varint()).decode('utf-8'))
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--java', required=True, type=Path)
+    p.add_argument('--jar', required=True, type=Path)
+    p.add_argument('--directory', required=True, type=Path)
+    p.add_argument('--port', required=True, type=int)
+    p.add_argument('--marker', default='Done (')
+    p.add_argument('--timeout', type=int, default=300)
+    p.add_argument('--flat', action='store_true')
+    p.add_argument('--command', action='append', default=[], help='Private console command before save/stop')
+    a=p.parse_args()
+    directory=a.directory.resolve(); directory.mkdir(parents=True, exist_ok=True)
+    if not (directory/'server.properties').exists():
+        props=f'server-ip=127.0.0.1\nserver-port={a.port}\nonline-mode=false\nenable-query=false\nenable-rcon=false\nview-distance=3\nsimulation-distance=3\nmax-players=1\nlevel-name=world\nlevel-seed=20261009\nspawn-protection=0\nmotd=Private local port validation\n'
+        if a.flat: props+='level-type=minecraft:flat\ngenerator-settings={"layers":[{"block":"minecraft:bedrock","height":1},{"block":"minecraft:stone","height":3}],"biome":"minecraft:plains"}\n'
+        (directory/'server.properties').write_text(props)
+    props=(directory/'server.properties').read_text()
+    if f'server-ip=127.0.0.1\n' not in props or f'server-port={a.port}\n' not in props:
+        raise SystemExit('Refusing non-loopback or unexpected port properties')
+    (directory/'eula.txt').write_text('eula=true\n')
+    events=queue.Queue(); start=time.monotonic(); matched=False; sent_stop=False; status=None
+    logfile=directory/('console-'+str(time.time_ns())+'.log')
+    process=subprocess.Popen([str(a.java.resolve()),'-Xms512M','-Xmx2G','-jar',str(a.jar.resolve()),'--nogui'],cwd=directory,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,bufsize=1)
+    def read():
+        with logfile.open('w') as log:
+            for line in process.stdout:
+                log.write(line); log.flush(); events.put(line)
+    worker=threading.Thread(target=read,daemon=True); worker.start()
+    print(f'PID={process.pid} log={logfile}',flush=True)
+    while process.poll() is None and time.monotonic()-start<a.timeout:
+        try: line=events.get(timeout=1)
+        except queue.Empty: continue
+        if any(s in line for s in ('Done (','PORT_PROBE_','Starting Minecraft server on','ERROR','Exception')):print(line.rstrip(),flush=True)
+        if 'Done (' in line and status is None:
+            try:status=status_probe(a.port)
+            except Exception as error:status={'error':str(error)}
+            print('STATUS '+json.dumps(status),flush=True)
+        if a.marker in line and not sent_stop:
+            matched=True; process.stdin.write(''.join(command+'\n' for command in a.command)+'save-all flush\nstop\n'); process.stdin.flush(); sent_stop=True
+        if 'PORT_PROBE_FAIL' in line and not sent_stop:
+            process.stdin.write('stop\n');process.stdin.flush();sent_stop=True
+    if process.poll() is None:
+        print('Timeout: requesting graceful stop',flush=True)
+        try:process.stdin.write('stop\n');process.stdin.flush();process.wait(timeout=45)
+        except (BrokenPipeError, subprocess.TimeoutExpired):process.terminate();process.wait(timeout=15)
+    worker.join(timeout=5)
+    result={'jar':str(a.jar.resolve()),'jar_sha256':hashlib.sha256(a.jar.read_bytes()).hexdigest(),'commands':a.command,'directory':str(directory),'log':str(logfile),'port':a.port,'loopback':'127.0.0.1','marker':a.marker,'status':status,'matched':matched,'exit_code':process.returncode,'elapsed_seconds':round(time.monotonic()-start,2)}
+    receipt=directory/('receipt-'+str(time.time_ns())+'.json');receipt.write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result),flush=True)
+    raise SystemExit(0 if matched and process.returncode==0 and status is not None and 'error' not in status else 1)
+
+if __name__=='__main__':main()
