+package io.papermc.testplugin;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Random;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.logging.Level;
+import org.bukkit.Bukkit;
+import org.bukkit.Chunk;
+import org.bukkit.ChunkSnapshot;
+import org.bukkit.Location;
+import org.bukkit.Material;
+import org.bukkit.NamespacedKey;
+import org.bukkit.World;
+import org.bukkit.WorldCreator;
+import org.bukkit.block.Biome;
+import org.bukkit.block.BlockFace;
+import org.bukkit.block.data.type.IceCrystal;
+import org.bukkit.block.data.type.Icicle;
+import org.bukkit.block.data.type.Speleothem;
+import org.bukkit.entity.Frostbite;
+import org.bukkit.entity.IceBall;
+import org.bukkit.generator.ChunkGenerator;
+import org.bukkit.generator.WorldInfo;
+import org.bukkit.persistence.PersistentDataType;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.bukkit.potion.PotionEffectType;
+import org.bukkit.structure.Structure;
+import org.bukkit.structure.StructureManager;
+import org.bukkit.util.BlockVector;
+import org.bukkit.util.Vector;
+
+/** Private two-boot validation instrument. Package separately from Paper-Test-Plugin. */
+public final class LocalPortProbe extends JavaPlugin {
+    private static final int CHUNK_X = 32;
+    private static final int CHUNK_Z = 32;
+    private final Map<String, String> receipt = new LinkedHashMap<>();
+
+    @Override
+    public void onEnable() {
+        Bukkit.getScheduler().runTaskLater(this, () -> {
+            if (Files.exists(this.getDataFolder().toPath().resolve("upgrade-only"))) this.runUpgradeProbe();
+            else this.runProbe();
+        }, 20L);
+    }
+
+    private void runUpgradeProbe() {
+        try {
+            World world = java.util.Objects.requireNonNull(Bukkit.getWorld("world"));
+            Chunk chunk = world.getChunkAt(0, 0); // An existing 26.3 chunk in the copied flat world.
+            require(chunk.getBlock(0, world.getMinHeight(), 0).getType() == Material.BEDROCK, "old flat terrain changed during conversion");
+            require(world.getBiome(0, 100, 0) == Biome.PLAINS, "old flat biome changed during conversion");
+            NamespacedKey key = new NamespacedKey(this, "upgrade_roundtrip");
+            boolean restart = chunk.getPersistentDataContainer().has(key, PersistentDataType.STRING);
+            if (restart) require(chunk.getBlock(0, 100, 0).getType() == Material.DIAMOND_BLOCK, "converted chunk lost its saved block");
+            else {
+                chunk.getBlock(0, 100, 0).setType(Material.DIAMOND_BLOCK, false);
+                chunk.getPersistentDataContainer().set(key, PersistentDataType.STRING, "converted_chunk");
+            }
+            world.save();
+            this.getLogger().info("UPGRADE_PROBE_PASS phase=" + (restart ? 2 : 1) + " old_chunk=0,0 terrain_biome_block_pdc=pass");
+        } catch (Throwable failure) {
+            this.getLogger().log(Level.SEVERE, "PORT_PROBE_FAIL upgrade", failure);
+        }
+    }
+
+    private static void require(boolean condition, String message) {
+        if (!condition) throw new IllegalStateException(message);
+    }
+
+    private void runProbe() {
+        int phase = 1;
+        try {
+            Path directory = this.getDataFolder().toPath();
+            Files.createDirectories(directory);
+            Path indicator = directory.resolve("phase1-complete");
+            phase = Files.exists(indicator) ? 2 : 1;
+            this.receipt.put("phase", Integer.toString(phase));
+            this.receipt.put("minecraft", Bukkit.getMinecraftVersion());
+            this.receipt.put("bukkit", Bukkit.getBukkitVersion());
+            World world = java.util.Objects.requireNonNull(Bukkit.getWorld("world"), "private harness world missing");
+            Chunk chunk = world.getChunkAt(CHUNK_X, CHUNK_Z);
+            if (phase == 1) {
+                try {
+                    world.regenerateChunk(CHUNK_X, CHUNK_Z);
+                    throw new IllegalStateException("regenerateChunk unexpectedly implemented: review probe contract");
+                } catch (UnsupportedOperationException expected) {
+                    this.receipt.put("regenerateChunk", "unsupported_expected_by_API");
+                }
+                boolean solid = false;
+                for (int y = world.getMinHeight(); y < world.getMaxHeight(); y++) {
+                    if (chunk.getBlock(8, y, 8).getType().isSolid()) solid = true;
+                }
+                require(solid, "vanilla generation produced no solid terrain");
+                this.receipt.put("vanilla_chunk", "32,32_generated_with_solid_terrain");
+                world.setBiome(513, 100, 513, Biome.DESERT);
+                world.setBiome(514, 100, 513, Biome.PLAINS);
+                chunk.getPersistentDataContainer().set(new NamespacedKey(this, "chunk_roundtrip"), PersistentDataType.STRING, "phase1");
+            } else {
+                require("phase1".equals(chunk.getPersistentDataContainer().get(new NamespacedKey(this, "chunk_roundtrip"), PersistentDataType.STRING)), "chunk PDC lost across restart");
+                this.receipt.put("chunk_pdc", "restart_roundtrip_pass");
+            }
+            require(world.getBiome(513, 100, 513) == Biome.DESERT, "adjacent desert biome lost");
+            require(world.getBiome(514, 100, 513) == Biome.PLAINS, "adjacent plains biome lost");
+            ChunkSnapshot snapshot = chunk.getChunkSnapshot(true, true, false, false);
+            require(snapshot.getBiome(1, 100, 1) == Biome.DESERT, "snapshot desert biome imprecise");
+            require(snapshot.getBiome(2, 100, 1) == Biome.PLAINS, "snapshot plains biome imprecise");
+            this.receipt.put("biome_precision", "world_and_snapshot_adjacent_blocks_pass");
+            this.checkBlocksAndEntities(world);
+            this.checkStructure(world, directory, phase);
+            this.checkCallbacks(phase);
+            world.save();
+            if (phase == 1) {
+                this.receipt.put("chunk_pdc", "phase1_written_restart_pending");
+            }
+            this.writeReceipt(directory.resolve("phase-" + phase + ".properties"));
+            if (phase == 1) Files.writeString(indicator, "phase1 passed; phase2 requires graceful harness restart\n");
+            this.getLogger().info("PORT_PROBE_PASS phase=" + phase + " receipt=" + directory.resolve("phase-" + phase + ".properties"));
+        } catch (Throwable failure) {
+            this.receipt.put("status", "FAIL");
+            this.receipt.put("failure", failure.toString());
+            try {
+                Files.createDirectories(this.getDataFolder().toPath());
+                this.writeReceipt(this.getDataFolder().toPath().resolve("phase-" + phase + "-failure.properties"));
+            } catch (Exception receiptFailure) {
+                failure.addSuppressed(receiptFailure);
+            }
+            this.getLogger().log(Level.SEVERE, "PORT_PROBE_FAIL phase=" + phase, failure);
+        }
+    }
+
+    private void writeReceipt(Path path) throws java.io.IOException {
+        StringBuilder text = new StringBuilder();
+        this.receipt.forEach((key, value) -> text.append(key).append('=').append(value.replace('\n', ' ')).append('\n'));
+        Files.writeString(path, text);
+    }
+
+    private void checkBlocksAndEntities(World world) {
+        IceCrystal crystal = (IceCrystal) Material.ICE_CRYSTAL.createBlockData();
+        crystal.setFacing(BlockFace.NORTH);
+        crystal.setWaterlogged(true);
+        require(crystal.getFacing() == BlockFace.NORTH && crystal.isWaterlogged(), "IceCrystal facade state mismatch");
+        require(crystal.getSoundGroup().getPlaceSound() != null && crystal.getSoundGroup().getBreakSound() != null, "IceCrystal sound group missing");
+        Icicle icicle = (Icicle) Material.ICICLE.createBlockData();
+        icicle.setVerticalDirection(BlockFace.DOWN);
+        icicle.setThickness(Speleothem.Thickness.TIP);
+        icicle.setAttached(true);
+        icicle.setWaterlogged(true);
+        require(icicle.getVerticalDirection() == BlockFace.DOWN && icicle.getThickness() == Speleothem.Thickness.TIP && icicle.isAttached() && icicle.isWaterlogged(), "Icicle facade state mismatch");
+        require(icicle.getSoundGroup().getPlaceSound() != null && icicle.getSoundGroup().getBreakSound() != null, "Icicle sound group missing");
+        world.getBlockAt(516, 150, 516).setBlockData(crystal, false);
+        world.getBlockAt(517, 150, 516).setBlockData(icicle, false);
+        require(world.getBlockAt(516, 150, 516).getBlockData() instanceof IceCrystal, "IceCrystal block bridge mismatch");
+        require(world.getBlockAt(517, 150, 516).getBlockData() instanceof Icicle, "Icicle block bridge mismatch");
+        this.receipt.put("snapshot_blocks", "ice_crystal_icicle_state_sound_world_bridges_pass");
+        require(PotionEffectType.FREEZING != null && "freezing".equals(PotionEffectType.FREEZING.getKey().getKey()), "FREEZING registration missing");
+        Frostbite frostbite = world.spawn(new Location(world, 520.5, 151, 520.5), Frostbite.class);
+        IceBall ball = null;
+        try {
+            frostbite.setAI(false);
+            require(frostbite.getType() == org.bukkit.entity.EntityType.FROSTBITE, "Frostbite entity type mismatch");
+            ball = frostbite.launchProjectile(IceBall.class, new Vector(0.1, 0.0, 0.0));
+            require(ball.getType() == org.bukkit.entity.EntityType.ICE_BALL && ball.getShooter() == frostbite, "IceBall launch/shooter bridge mismatch");
+            this.receipt.put("snapshot_entities", "frostbite_spawn_livingentity_iceball_launch_freezing_registry_pass");
+        } finally {
+            if (ball != null) ball.remove();
+            frostbite.remove();
+        }
+    }
+
+    private void checkStructure(World world, Path directory, int phase) throws java.io.IOException {
+        StructureManager manager = Bukkit.getStructureManager();
+        NamespacedKey key = new NamespacedKey(this, "structure_roundtrip");
+        Path file = directory.resolve("structure-roundtrip.nbt");
+        if (phase == 1) {
+            Structure structure = manager.createStructure();
+            structure.fill(new Location(world, 516, 150, 516), new BlockVector(2, 1, 1), false);
+            require(structure.getSize().equals(new BlockVector(2, 1, 1)), "structure capture size mismatch");
+            require(structure.getPaletteCount() == 1 && structure.getPalettes().getFirst().getBlockCount() == 2, "structure capture palette mismatch");
+            structure.getPersistentDataContainer().set(key, PersistentDataType.STRING, "phase1_structure");
+            manager.saveStructure(file.toFile(), structure);
+        }
+        Structure loaded = manager.loadStructure(file.toFile());
+        require("phase1_structure".equals(loaded.getPersistentDataContainer().get(key, PersistentDataType.STRING)), "structure PDC serialization lost");
+        require(loaded.getPalettes().getFirst().getBlocks().stream().anyMatch(block -> block.getType() == Material.ICE_CRYSTAL), "saved structure IceCrystal missing");
+        require(loaded.getPalettes().getFirst().getBlocks().stream().anyMatch(block -> block.getType() == Material.ICICLE), "saved structure Icicle missing");
+        this.receipt.put("structure", phase == 1 ? "create_fill_save_load_pdc_pass" : "restart_file_load_pdc_pass");
+    }
+
+    private void checkCallbacks(int phase) {
+        CallbackGenerator generator = new CallbackGenerator();
+        World callbacks = java.util.Objects.requireNonNull(Bukkit.createWorld(new WorldCreator("callback_probe").seed(246403L).generator(generator).keepSpawnLoaded(net.kyori.adventure.util.TriState.FALSE)), "callback world creation failed");
+        for (int x : new int[] {32, 33}) {
+            Chunk chunk = callbacks.getChunkAt(x, 32);
+            require(chunk.getBlock(8, 100, 8).getType() == Material.DIAMOND_BLOCK, "callback final block mismatch chunk=" + x + ",32");
+            require(chunk.getBlock(9, 100, 8).getType() == Material.AIR, "disabled vanilla stages filled adjacent block");
+            if (phase == 1) require("noise,surface,caves".equals(generator.order.get(x + ",32")), "callback sequence mismatch chunk=" + x + ",32");
+        }
+        Throwable failure = generator.failure.get();
+        if (failure != null) throw new IllegalStateException("asynchronous callback assertion failed", failure);
+        callbacks.save();
+        this.receipt.put("custom_callbacks", phase == 1 ? "two_chunks_noise_surface_caves_order_vanilla_disabled_pass" : "two_chunks_persisted_diamond_pass");
+    }
+
+    private static final class CallbackGenerator extends ChunkGenerator {
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Map<String, String> order = new ConcurrentHashMap<>();
+
+        @Override public Location getFixedSpawnLocation(World world, Random random) { return new Location(world, 8.5, 101, 8.5); }
+        @Override public boolean isParallelCapable() { return true; }
+        @Override public boolean shouldGenerateNoise() { return false; }
+        @Override public boolean shouldGenerateSurface() { return false; }
+        @Override public boolean shouldGenerateCaves() { return false; }
+        @Override public boolean shouldGenerateDecorations() { return false; }
+        @Override public boolean shouldGenerateStructures() { return false; }
+        @Override public boolean shouldGenerateMobs() { return false; }
+
+        private void stage(int x, int z, String previous, String next, Material expected, Material result, ChunkData data) {
+            try {
+                String key = x + "," + z;
+                require(previous.equals(this.order.getOrDefault(key, "")), "wrong callback order " + key + " expected=" + previous);
+                require(data.getType(8, 100, 8) == expected, "previous callback block overwritten " + key + " expected=" + expected);
+                require(data.getType(9, 100, 8) == Material.AIR, "vanilla terrain generated despite flags " + key);
+                data.setBlock(8, 100, 8, result);
+                this.order.put(key, next);
+            } catch (Throwable error) {
+                this.failure.compareAndSet(null, error);
+                throw error;
+            }
+        }
+        @Override public void generateNoise(WorldInfo world, Random random, int x, int z, ChunkData data) { this.stage(x, z, "", "noise", Material.AIR, Material.STONE, data); }
+        @Override public void generateSurface(WorldInfo world, Random random, int x, int z, ChunkData data) { this.stage(x, z, "noise", "noise,surface", Material.STONE, Material.EMERALD_BLOCK, data); }
+        @Override public void generateCaves(WorldInfo world, Random random, int x, int z, ChunkData data) { this.stage(x, z, "noise,surface", "noise,surface,caves", Material.EMERALD_BLOCK, Material.DIAMOND_BLOCK, data); }
+    }
+}
