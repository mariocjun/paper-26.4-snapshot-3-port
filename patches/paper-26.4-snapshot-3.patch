+#!/usr/bin/env python3
+"""Package only LocalPortProbe classes from a built test-plugin JAR, unchanged."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import zipfile
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--input', type=Path, required=True, help='Compiled test-plugin JAR')
+parser.add_argument('--output', type=Path, required=True, help='Separate probe JAR')
+args = parser.parse_args()
+source = args.input.resolve(strict=True)
+output = args.output.resolve()
+if source == output:
+    parser.error('Input and output must differ; original JAR is preserved')
+original_hash = hashlib.sha256(source.read_bytes()).hexdigest()
+with zipfile.ZipFile(source) as archive:
+    classes = sorted(name for name in archive.namelist()
+                     if name.startswith('io/papermc/testplugin/LocalPortProbe') and name.endswith('.class'))
+    if 'io/papermc/testplugin/LocalPortProbe.class' not in classes:
+        parser.error('LocalPortProbe.class missing; run :test-plugin:jar first')
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with zipfile.ZipFile(output, 'w', compression=zipfile.ZIP_DEFLATED) as probe:
+        for name in classes:
+            probe.writestr(name, archive.read(name))
+        probe.writestr('plugin.yml', 'name: LocalPortProbe\nversion: 1.0.0-local\nmain: io.papermc.testplugin.LocalPortProbe\napi-version: "26.4"\ndescription: Private two-boot local port validation instrument\n')
+assert hashlib.sha256(source.read_bytes()).hexdigest() == original_hash
+receipt = {'source': str(source), 'source_sha256': original_hash,
+           'output': str(output), 'sha256': hashlib.sha256(output.read_bytes()).hexdigest(),
+           'classes': classes, 'original_unchanged': True}
+output.with_suffix('.packaging.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print(json.dumps(receipt, indent=2))
