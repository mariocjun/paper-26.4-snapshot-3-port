diff --git a/paper-server/src/test/java/io/papermc/paper/network/TypedCustomPayloadBridgeTest.java b/paper-server/src/test/java/io/papermc/paper/network/TypedCustomPayloadBridgeTest.java
new file mode 100644
index 0000000..f793f5d
--- /dev/null
+++ b/paper-server/src/test/java/io/papermc/paper/network/TypedCustomPayloadBridgeTest.java
@@ -0,0 +1,75 @@
+package io.papermc.paper.network;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.util.HashMap;
+import java.util.Map;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.protocol.common.custom.BrandPayload;
+import net.minecraft.network.protocol.common.custom.ModListPayload;
+import net.minecraft.network.protocol.common.custom.PropertyMap;
+import net.minecraft.resources.Identifier;
+import org.junit.jupiter.api.Test;
+import org.bukkit.support.environment.Normal;
+
+@Normal
+class TypedCustomPayloadBridgeTest {
+
+    @Test
+    void brandAtPaperLimitPreservesTheVanillaBody() {
+        BrandPayload payload = new BrandPayload("a".repeat(256));
+        byte[] data = TypedCustomPayloadBridge.encode(payload);
+        FriendlyByteBuf buffer = new FriendlyByteBuf(Unpooled.wrappedBuffer(data));
+        try {
+            assertEquals(payload, BrandPayload.STREAM_CODEC.decode(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void brandPastPaperLimitIsRejected() {
+        assertThrows(io.netty.handler.codec.DecoderException.class,
+            () -> TypedCustomPayloadBridge.encode(new BrandPayload("a".repeat(257))));
+    }
+
+    @Test
+    void brandLimitAllowsMultibyteCharacters() {
+        BrandPayload payload = new BrandPayload("\u00e9".repeat(256));
+        assertDoesNotThrow(() -> TypedCustomPayloadBridge.encode(payload));
+    }
+
+    @Test
+    void modListIsExactlyOneVanillaBodyWithoutAChannelPrefix() {
+        ModListPayload payload = new ModListPayload(Map.of(
+            Identifier.parse("example:mod"), new PropertyMap(Map.of(Identifier.parse("example:version"), "1.2.3"))));
+        byte[] data = TypedCustomPayloadBridge.encode(payload);
+        ByteBuf expected = Unpooled.buffer();
+        ByteBuf received = Unpooled.wrappedBuffer(data);
+        try {
+            ModListPayload.STREAM_CODEC.encode(expected, payload);
+            byte[] expectedData = new byte[expected.readableBytes()];
+            expected.readBytes(expectedData);
+            assertArrayEquals(expectedData, data);
+            assertEquals(payload, ModListPayload.STREAM_CODEC.decode(received));
+            assertEquals(0, received.readableBytes());
+        } finally {
+            expected.release();
+            received.release();
+        }
+    }
+
+    @Test
+    void modListCannotExceedTheOriginalPaperPayloadLimit() {
+        Map<Identifier, PropertyMap> mods = new HashMap<>();
+        for (int i = 0; i < 512; i++) {
+            mods.put(Identifier.parse("example:mod_" + i),
+                new PropertyMap(Map.of(Identifier.parse("example:version"), "a".repeat(120))));
+        }
+        assertThrows(IndexOutOfBoundsException.class,
+            () -> TypedCustomPayloadBridge.encode(new ModListPayload(mods)));
