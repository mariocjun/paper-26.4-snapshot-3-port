+package org.bukkit.craftbukkit;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import net.kyori.adventure.key.Key;
+import net.minecraft.core.Holder;
+import net.minecraft.core.registries.Registries;
+import net.minecraft.world.level.biome.Biomes;
+import net.minecraft.world.level.chunk.PalettedContainer;
+import net.minecraft.world.level.chunk.PalettedContainerFactory;
+import net.minecraft.world.level.chunk.PalettedContainerRO;
+import org.bukkit.craftbukkit.block.CraftBiome;
+import org.bukkit.support.RegistryHelper;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.Test;
+
+@VanillaFeature
+class ChunkSnapshotBiomeTest {
+    @Test
+    @SuppressWarnings("unchecked")
+    void snapshotUsesBlockCoordinatesAndNegativeSectionHeight() {
+        var registry = RegistryHelper.registryAccess().lookupOrThrow(Registries.BIOME);
+        var desert = registry.getOrThrow(Biomes.DESERT);
+        var plains = registry.getOrThrow(Biomes.PLAINS);
+        PalettedContainer<Holder<net.minecraft.world.level.biome.Biome>> palette = PalettedContainerFactory.create(RegistryHelper.registryAccess()).createForBiomes();
+        palette.set(3, 3, 3, desert);
+        palette.set(12, 12, 12, plains);
+        PalettedContainerRO<Holder<net.minecraft.world.level.biome.Biome>>[] biomes = new PalettedContainerRO[] {palette};
+        var snapshot = new CraftChunkSnapshot(0, 0, -16, 0, 63, "test", Key.key("test:world"), 0, null, null, null, null, null, biomes);
+        assertEquals(CraftBiome.minecraftHolderToBukkit(plains), snapshot.getBiome(12, -4, 12));
+        assertEquals(CraftBiome.minecraftHolderToBukkit(desert), snapshot.getBiome(3, -13, 3));
+        assertEquals(plains.value().getTemperature(new net.minecraft.core.BlockPos(12, -4, 12), 63), snapshot.getRawBiomeTemperature(12, -4, 12));
+    }
+}
