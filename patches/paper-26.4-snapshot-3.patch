@@ -0,0 +1,182 @@
+package org.bukkit.craftbukkit.generator;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Holder;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.LevelHeightAccessor;
+import net.minecraft.world.level.biome.Biome;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.chunk.CarvingMask;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import net.minecraft.world.level.levelgen.Aquifer;
+import net.minecraft.world.level.levelgen.ChunkTerrainBuilder;
+import net.minecraft.world.level.levelgen.RandomState;
+import net.minecraft.world.level.levelgen.SurfaceExtensions;
+import net.minecraft.world.level.levelgen.VerticalAnchor;
+import net.minecraft.world.level.levelgen.densityfunction.DensitySamplerSet;
+import net.minecraft.world.level.levelgen.densityfunction.DensityVolume;
+import net.minecraft.world.level.levelgen.material.MaterialRuleContext;
+import net.minecraft.world.level.levelgen.material.MaterialSystem;
+import net.minecraft.world.level.levelgen.material.rule.MaterialRule;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.AfterEach;
+
+@VanillaFeature
+class TerrainStagesTest {
+    private final java.util.List<BlockPos> postProcessing = new java.util.ArrayList<>();
+    private final Map<BlockPos, BlockState> blocks = new HashMap<>();
+    private final ChunkAccess chunk = mock(ChunkAccess.class);
+    private MaterialRuleContext context;
+    private final java.util.List<ChunkTerrainBuilder> builders = new java.util.ArrayList<>();
+
+    @AfterEach
+    void closeBuilders() {
+        for (int i = this.builders.size() - 1; i >= 0; i--) {
+            this.builders.get(i).close();
+        }
+    }
+
+    private static ca.spottedleaf.moonrise.patches.chunk_gen.buffer_alloc.ThreadLocalFixedDensityBufferCache allocator(final MaterialRuleContext context) {
+        ca.spottedleaf.moonrise.patches.chunk_gen.buffer_alloc.ThreadLocalFixedDensityBufferCache allocator = context.moonrise$removeDensityBufferAllocator();
+        context.moonrise$setDensityBufferAllocator(allocator);
+        return allocator;
+    }
+
+    private ChunkTerrainBuilder builder(final net.minecraft.world.level.levelgen.material.rule.RuleEvaluator evaluator) {
+        return this.builder(evaluator, false);
+    }
+
+    private ChunkTerrainBuilder builder(final net.minecraft.world.level.levelgen.material.rule.RuleEvaluator evaluator, final boolean failCompile) {
+        LevelHeightAccessor height = LevelHeightAccessor.create(0, 32);
+        when(this.chunk.getPos()).thenReturn(new ChunkPos(0, 0));
+        doAnswer(invocation -> {
+            this.postProcessing.add(((BlockPos) invocation.getArgument(0)).immutable());
+            return null;
+        }).when(this.chunk).markPosForPostProcessing(any());
+        when(this.chunk.getHeightAccessorForGeneration()).thenReturn(height);
+        when(this.chunk.getBlockState(any())).thenAnswer(invocation -> this.blocks.getOrDefault(invocation.getArgument(0), Blocks.AIR.defaultBlockState()));
+        doAnswer(invocation -> this.blocks.put(((BlockPos) invocation.getArgument(0)).immutable(), invocation.getArgument(1))).when(this.chunk).setBlockState(any(), any());
+        when(this.chunk.getBiome(anyInt(), anyInt(), anyInt())).thenReturn(Holder.direct(mock(Biome.class)));
+        when(this.chunk.getSectionIndex(anyInt())).thenAnswer(invocation -> (int) invocation.getArgument(0) >> 4);
+        for (int sectionIndex = 0; sectionIndex < 2; sectionIndex++) {
+            int minY = sectionIndex * 16;
+            LevelChunkSection section = mock(LevelChunkSection.class);
+            when(this.chunk.getSection(sectionIndex)).thenReturn(section);
+            when(section.setBlockState(anyInt(), anyInt(), anyInt(), any(), eq(false))).thenAnswer(invocation -> this.blocks.put(new BlockPos((int) invocation.getArgument(0), minY + (int) invocation.getArgument(1), (int) invocation.getArgument(2)), invocation.getArgument(3)));
+        }
+        RandomState randomState = mock(RandomState.class);
+        MaterialSystem system = mock(MaterialSystem.class);
+        when(randomState.materialSystem()).thenReturn(system);
+        when(system.surfaceExtensions()).thenReturn(mock(SurfaceExtensions.class));
+        MaterialRule rule = mock(MaterialRule.class);
+        when(rule.compile(any())).thenAnswer(invocation -> {
+            this.context = invocation.getArgument(0);
+            if (failCompile) {
+                throw new IllegalStateException("material compile failure");
+            }
+            return evaluator;
+        });
+        ChunkTerrainBuilder builder = new ChunkTerrainBuilder(randomState, mock(DensitySamplerSet.class), new DensityVolume(16, 16, 16, 0, 0, 0), new VerticalAnchor.Context(0, 32, 8), rule, this.chunk, Set.of());
+        this.builders.add(builder);
+        return builder;
+    }
+
+    @Test
+    void failedRuleCompilationReturnsMaterialCache() {
+        assertThrows(IllegalStateException.class, () -> this.builder((x, y, z) -> null, true));
+        try (ChunkTerrainBuilder builder = this.builder((x, y, z) -> null)) {
+            assertNotNull(allocator(this.context));
+        }
+    }
+
+    @Test
+    void nestedMaterialBuilderDoesNotShareActiveCache() {
+        try (ChunkTerrainBuilder outer = this.builder((x, y, z) -> null)) {
+            MaterialRuleContext outerContext = this.context;
+            Object outerAllocator = allocator(outerContext);
+            assertNotNull(outerAllocator);
+            try (ChunkTerrainBuilder nested = this.builder((x, y, z) -> null)) {
+                assertNull(allocator(this.context));
+                assertSame(outerAllocator, allocator(outerContext));
+            }
+        }
+        try (ChunkTerrainBuilder next = this.builder((x, y, z) -> null)) {
+            assertNotNull(allocator(this.context));
+        }
+    }
+
+    @Test
+    void failedMaterialEvaluationReturnsMaterialCache() {
+        assertThrows(IllegalStateException.class, () -> {
+            try (ChunkTerrainBuilder builder = this.builder((x, y, z) -> { throw new IllegalStateException("material evaluation failure"); })) {
+                this.blocks.put(new BlockPos(0, 10, 0), Blocks.STONE.defaultBlockState());
+                builder.buildSurface(this.chunk, Blocks.STONE.defaultBlockState());
+            }
+        });
+        try (ChunkTerrainBuilder next = this.builder((x, y, z) -> null)) {
+            assertNotNull(allocator(this.context));
+        }
+    }
+
+    @Test
+    void baseMaterialUsesConfiguredUnconditionalRuleForEachDimension() {
+        assertEquals(Blocks.END_STONE.defaultBlockState(), ChunkTerrainBuilder.baseBlock(new net.minecraft.world.level.levelgen.material.rule.BlockRule(Blocks.END_STONE.defaultBlockState())));
+        MaterialRule nether = new net.minecraft.world.level.levelgen.material.rule.SequenceRule(java.util.List.of(mock(MaterialRule.class), new net.minecraft.world.level.levelgen.material.rule.BlockRule(Blocks.NETHERRACK.defaultBlockState())));
+        assertEquals(Blocks.NETHERRACK.defaultBlockState(), ChunkTerrainBuilder.baseBlock(new MaterialRule.HolderHolder(Holder.direct(nether))));
+        MaterialRule custom = new net.minecraft.world.level.levelgen.material.rule.SequenceRule(java.util.List.of(mock(MaterialRule.class), new net.minecraft.world.level.levelgen.material.rule.BlockRule(Blocks.DIAMOND_BLOCK.defaultBlockState())));
+        assertEquals(Blocks.DIAMOND_BLOCK.defaultBlockState(), ChunkTerrainBuilder.baseBlock(custom));
+    }
+
+    @Test
+    void surfaceReadsPluginNoiseAboveDelegateVolumeAndKeepsFluids() {
+        ChunkTerrainBuilder builder = this.builder((x, y, z) -> this.context.stoneDepthAbove() == 1 ? Blocks.GRASS_BLOCK.defaultBlockState() : null);
+        this.blocks.put(new BlockPos(0, 20, 0), Blocks.STONE.defaultBlockState());
+        this.blocks.put(new BlockPos(0, 19, 0), Blocks.DIAMOND_BLOCK.defaultBlockState());
+        this.blocks.put(new BlockPos(1, 20, 0), Blocks.WATER.defaultBlockState());
+        builder.buildSurface(this.chunk, Blocks.STONE.defaultBlockState());
+        assertEquals(Blocks.GRASS_BLOCK.defaultBlockState(), this.blocks.get(new BlockPos(0, 20, 0)));
+        assertEquals(Blocks.DIAMOND_BLOCK.defaultBlockState(), this.blocks.get(new BlockPos(0, 19, 0)));
+        assertEquals(Blocks.WATER.defaultBlockState(), this.blocks.get(new BlockPos(1, 20, 0)));
+    }
+
+    @Test
+    void carvingSeesPluginSurfaceAndPromotesExposedDirt() {
+        ChunkTerrainBuilder builder = this.builder((x, y, z) -> Blocks.GRASS_BLOCK.defaultBlockState());
+        this.blocks.put(new BlockPos(0, 10, 0), Blocks.GRASS_BLOCK.defaultBlockState());
+        this.blocks.put(new BlockPos(0, 9, 0), Blocks.DIRT.defaultBlockState());
+        this.blocks.put(new BlockPos(1, 10, 0), Blocks.BEDROCK.defaultBlockState());
+        CarvingMask mask = new CarvingMask(1, 30);
+        mask.carve(0, 10, 0);
+        mask.carve(1, 10, 0);
+        Aquifer aquifer = mock(Aquifer.class);
+        when(aquifer.computeSubstance(anyInt(), anyInt(), anyInt(), eq(0.0))).thenReturn(Blocks.AIR.defaultBlockState());
+        builder.applyCarvingMask(this.chunk, mask, aquifer);
+        assertEquals(Blocks.AIR.defaultBlockState(), this.blocks.get(new BlockPos(0, 10, 0)));
+        assertEquals(Blocks.GRASS_BLOCK.defaultBlockState(), this.blocks.get(new BlockPos(0, 9, 0)));
+        assertEquals(Blocks.BEDROCK.defaultBlockState(), this.blocks.get(new BlockPos(1, 10, 0)));
+    }
+
+    @Test
+    void carvedAquiferFluidIsScheduled() {
+        ChunkTerrainBuilder builder = this.builder((x, y, z) -> null);
+        this.blocks.put(new BlockPos(0, 10, 0), Blocks.STONE.defaultBlockState());
+        CarvingMask mask = new CarvingMask(1, 30);
+        mask.carve(0, 10, 0);
+        Aquifer aquifer = mock(Aquifer.class);
+        when(aquifer.computeSubstance(anyInt(), anyInt(), anyInt(), eq(0.0))).thenReturn(Blocks.WATER.defaultBlockState());
+        when(aquifer.shouldScheduleFluidUpdate()).thenReturn(true);
+        builder.applyCarvingMask(this.chunk, mask, aquifer);
+        assertEquals(Blocks.WATER.defaultBlockState(), this.blocks.get(new BlockPos(0, 10, 0)));
+        assertTrue(this.postProcessing.contains(new BlockPos(0, 10, 0)));
+    }
+}
